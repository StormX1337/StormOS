<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StormOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    Title="STORM OS">

    <Grid x:Name="RootGrid" Background="{ThemeResource StormBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/StormOS.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="STORM OS" FontWeight="SemiBold" CharacterSpacing="120" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind h:Format.ShowText(ViewModel.ActiveGame), Mode=OneWay}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="12" Foreground="{ThemeResource StormAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveGame, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource StormTextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource StormTextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Games" Tag="games"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Benchmark" Tag="benchmark"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Optimizer" Tag="optimizer"><NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="network"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Processes" Tag="processes"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Startup" Tag="startup"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Power" Tag="power"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7E8;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Overlay" Tag="overlay"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Devices" Tag="devices"><NavigationViewItem.Icon><FontIcon Glyph="&#xE772;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6" Padding="24,12,24,0">
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsMock, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Development mock data"
                        Message="This build shows synthetic telemetry for UI development. Values are not measured." />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ServiceUnavailable, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Limited mode"
                        Message="The STORM OS service is not running. Live monitoring works; frame timing, sessions and changes that need administrator rights are unavailable. Start it with 'storm service start' (as administrator) or reinstall STORM OS." />
                    <InfoBar
                        x:Name="NotificationBar"
                        IsOpen="{x:Bind ViewModel.Notifications.HasNotification, Mode=OneWay}"
                        Title="{x:Bind ViewModel.Notifications.Current.Title, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Notifications.Current.Message, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.Notifications.Current.Severity, Mode=OneWay}"
                        Closed="OnNotificationClosed" />
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>

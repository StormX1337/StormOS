<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers">

    <ScrollViewer>
        <StackPanel Padding="28,16,28,28" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource StormPageTitleStyle}" />
                <TextBlock Text="Changes are saved immediately. Privacy defaults are data-minimal: nothing leaves this PC unless you enable it." Style="{StaticResource StormPageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GENERAL" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start minimized" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="APPEARANCE" Style="{StaticResource StormSectionTitleStyle}" />
                    <ComboBox Header="Theme" MinWidth="220" ItemsSource="{x:Bind ViewModel.Themes}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                    <ToggleSwitch Header="Mica backdrop (applies after restart)" IsOn="{x:Bind ViewModel.UseMica, Mode=TwoWay}" />
                    <ToggleSwitch Header="Reduce motion" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="PERFORMANCE" Style="{StaticResource StormSectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="Sampling interval" MinWidth="180" ItemsSource="{x:Bind ViewModel.SamplingOptions}" SelectedIndex="{x:Bind ViewModel.SamplingIndex, Mode=TwoWay}" />
                        <ComboBox Header="While a game runs" MinWidth="180" ItemsSource="{x:Bind ViewModel.SamplingOptions}" SelectedIndex="{x:Bind ViewModel.GameSamplingIndex, Mode=TwoWay}" />
                        <NumberBox Header="Keep history (days)" Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}" />
                    </StackPanel>
                    <ToggleSwitch Header="Collect per-core CPU load" IsOn="{x:Bind ViewModel.CollectPerCore, Mode=TwoWay}" />
                    <ToggleSwitch Header="Capture frames automatically when a game starts" IsOn="{x:Bind ViewModel.AutoCaptureFrames, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GAMES" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Detect running games" IsOn="{x:Bind ViewModel.AutoDetect, Mode=TwoWay}" />
                    <ToggleSwitch Header="Scan launchers on startup" IsOn="{x:Bind ViewModel.ScanOnStartup, Mode=TwoWay}" />
                    <ToggleSwitch Header="Apply profile session settings while playing (e.g. process priority), restored on exit" IsOn="{x:Bind ViewModel.ApplyProfileSessionSettings, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="OPTIMIZATION" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Show advanced (medium/high risk) optimizations" IsOn="{x:Bind ViewModel.ShowAdvancedRules, Mode=TwoWay}" />
                    <ToggleSwitch Header="Restore session changes when a game exits" IsOn="{x:Bind ViewModel.RestoreOnGameExit, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="NETWORK" Style="{StaticResource StormSectionTitleStyle}" />
                    <TextBox Header="Latency target (host or IP)" Text="{x:Bind ViewModel.LatencyTarget, Mode=TwoWay}" MaxLength="253" />
                    <TextBox Header="DNS servers to compare (comma separated)" Text="{x:Bind ViewModel.AlternativeDns, Mode=TwoWay}" MaxLength="200" />
                    <TextBox Header="Download test URL (https)" Text="{x:Bind ViewModel.ThroughputUrl, Mode=TwoWay}" MaxLength="500" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkError, Mode=OneWay}" Foreground="{ThemeResource StormErrorBrush}" Visibility="{x:Bind h:Format.ShowText(ViewModel.NetworkError), Mode=OneWay}" />
                    <Button Content="Save network settings" Command="{x:Bind ViewModel.SaveNetworkCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Game detected" IsOn="{x:Bind ViewModel.NotifyGameDetected, Mode=TwoWay}" />
                    <ToggleSwitch Header="Optimization results" IsOn="{x:Bind ViewModel.NotifyOptimizationResults, Mode=TwoWay}" />
                    <ToggleSwitch Header="Health alerts (temperature, disk space)" IsOn="{x:Bind ViewModel.NotifyHealthAlerts, Mode=TwoWay}" />
                    <ToggleSwitch Header="Updates" IsOn="{x:Bind ViewModel.NotifyUpdates, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="PRIVACY" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Store performance history on this PC" IsOn="{x:Bind ViewModel.PrivacyPerformanceHistory, Mode=TwoWay}" />
                    <ToggleSwitch Header="Sync benchmarks and sessions to STORM Cloud" IsOn="{x:Bind ViewModel.PrivacyCloudSync, Mode=TwoWay}" />
                    <ToggleSwitch Header="Send crash reports" IsOn="{x:Bind ViewModel.PrivacyCrashReports, Mode=TwoWay}" />
                    <ToggleSwitch Header="Send anonymous diagnostics" IsOn="{x:Bind ViewModel.PrivacyAnonymousDiagnostics, Mode=TwoWay}" />
                    <ToggleSwitch Header="Usage telemetry" IsOn="{x:Bind ViewModel.PrivacyTelemetry, Mode=TwoWay}" />
                    <Button Content="Clear local history…" Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="STORM CLOUD" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Enable STORM Cloud (account, license, sync, AI analysis)" IsOn="{x:Bind ViewModel.CloudEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="API address" Width="420" Text="{x:Bind ViewModel.ApiBaseUrl, Mode=TwoWay}" />
                        <Button Content="Save" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SaveCloudUrlCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource StormCaptionStyle}"><Run Text="License: " /><Run Text="{x:Bind ViewModel.LicenseText, Mode=OneWay}" /></TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Format.Hide(ViewModel.IsSignedIn), Mode=OneWay}">
                        <TextBox Header="E-mail" Width="240" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" InputScope="EmailSmtpAddress" />
                        <PasswordBox Header="Password" Width="200" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                        <Button Content="Sign in" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SignInCommand}" />
                    </StackPanel>
                    <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" Visibility="{x:Bind h:Format.Show(ViewModel.IsSignedIn), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CloudError, Mode=OneWay}" Foreground="{ThemeResource StormErrorBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Format.ShowText(ViewModel.CloudError), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="UPDATES" Style="{StaticResource StormSectionTitleStyle}" />
                    <ComboBox Header="Channel" MinWidth="160" ItemsSource="{x:Bind ViewModel.Channels}" SelectedIndex="{x:Bind ViewModel.UpdateChannelIndex, Mode=TwoWay}" />
                    <ToggleSwitch Header="Check for updates automatically" IsOn="{x:Bind ViewModel.CheckUpdatesAutomatically, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.UpdateText, Mode=OneWay}" Style="{StaticResource StormBodyStyle}" TextWrapping="Wrap" />
                    <ProgressBar Maximum="100" Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" Visibility="{x:Bind h:Format.Show(ViewModel.IsBusy), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check now" Command="{x:Bind ViewModel.CheckUpdatesCommand}" />
                        <Button Content="Download and install…" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InstallUpdateCommand}" Visibility="{x:Bind h:Format.Show(ViewModel.UpdateAvailable), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StormPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ADVANCED" Style="{StaticResource StormSectionTitleStyle}" />
                    <ToggleSwitch Header="Developer logging (more detail, never secrets)" IsOn="{x:Bind ViewModel.DeveloperLogging, Mode=TwoWay}" />
                    <ToggleSwitch Header="Use ETW frame capture when PresentMon is unavailable" IsOn="{x:Bind ViewModel.AllowEtwFallback, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="PresentMon path (optional)" Width="420" Text="{x:Bind ViewModel.PresentMonPath, Mode=TwoWay}" PlaceholderText="C:\Program Files\PresentMon\PresentMon.exe" />
                        <Button Content="Save" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SavePresentMonCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StormCaptionStyle}" IsTextSelectionEnabled="True"><Run Text="Data: " /><Run Text="{x:Bind ViewModel.DataFolder}" /></TextBlock>
                    <TextBlock Style="{StaticResource StormCaptionStyle}" IsTextSelectionEnabled="True"><Run Text="Logs: " /><Run Text="{x:Bind ViewModel.LogFolder}" /></TextBlock>
                    <TextBlock Style="{StaticResource StormCaptionStyle}"><Run Text="STORM OS " /><Run Text="{x:Bind ViewModel.Version}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.BuildMode}" /></TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                        <Button Content="Run setup again" Command="{x:Bind ViewModel.RunOnboardingCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

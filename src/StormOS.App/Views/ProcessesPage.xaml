<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    xmlns:vm="using:StormOS.App.ViewModels">

    <Grid Padding="28,16,28,28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Processes" Style="{StaticResource StormPageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource StormPageSubtitleStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <AutoSuggestBox PlaceholderText="Search name, publisher or PID" QueryIcon="Find" Width="300" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox MinWidth="170" ItemsSource="{x:Bind ViewModel.Filters}" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" />
            <ComboBox MinWidth="120" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort by" />
            <ToggleButton Content="Pause updates" IsChecked="{x:Bind ViewModel.Paused, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="NAME" Style="{StaticResource StormLabelStyle}" />
            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource StormLabelStyle}" />
            <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource StormLabelStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource StormLabelStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="GPU" Style="{StaticResource StormLabelStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Text="PRIORITY" Style="{StaticResource StormLabelStyle}" />
            <TextBlock Grid.Column="6" Text="PUBLISHER" Style="{StaticResource StormLabelStyle}" />
            <TextBlock Grid.Column="7" Text="SIGNATURE" Style="{StaticResource StormLabelStyle}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource StormPanelStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="34" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessRow">
                        <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind PathText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PidText}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Cpu}" Style="{StaticResource StormValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Memory}" Style="{StaticResource StormValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Gpu}" Style="{StaticResource StormValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Priority}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="{x:Bind Publisher}" Style="{StaticResource StormCaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="{x:Bind Signature}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource StormPanelStyle}" Visibility="{x:Bind h:Format.Show(ViewModel.HasSelection), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Selected.PathText, Mode=OneWay}" Style="{StaticResource StormCaptionStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="140" ItemsSource="{x:Bind ViewModel.Priorities}" SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=TwoWay}" />
                    <Button Content="Set priority" Command="{x:Bind ViewModel.SetPriorityCommand}" />
                    <Button Content="Open file location" Command="{x:Bind ViewModel.OpenLocationCommand}" />
                    <Button Content="Verify signature" Command="{x:Bind ViewModel.VerifySignatureCommand}" />
                    <Button Content="End process" Command="{x:Bind ViewModel.EndProcessCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    xmlns:c="using:StormOS.App.Controls"
    xmlns:games="using:StormOS.Core.Games">

    <ScrollViewer>
        <StackPanel Padding="28,16,28,28" Spacing="16" MaxWidth="1600">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Performance" Style="{StaticResource StormPageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RangeSummary, Mode=OneWay}" Style="{StaticResource StormPageSubtitleStyle}" />
                </StackPanel>
                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="180" ItemsSource="{x:Bind ViewModel.Ranges}" SelectedIndex="{x:Bind ViewModel.SelectedRange, Mode=TwoWay}" />
            </Grid>

            <Border Style="{StaticResource StormPanelStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="FRAME CAPTURE" Style="{StaticResource StormSectionTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CaptureStatus, Mode=OneWay}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" MinWidth="220" PlaceholderText="Running game" ItemsSource="{x:Bind ViewModel.RunningGames}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="games:RunningGame"><TextBlock Text="{x:Bind DisplayName}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <Button Content="Start capture" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartCaptureCommand}" />
                        <Button Content="Stop" Command="{x:Bind ViewModel.StopCaptureCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>

                <Border Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <Grid><TextBlock Text="CPU" Style="{StaticResource StormSectionTitleStyle}" /><TextBlock HorizontalAlignment="Right" Text="{x:Bind h:Format.Reading(ViewModel.Snapshot.Cpu.Usage, '0', ' %'), Mode=OneWay}" Style="{StaticResource StormValueStyle}" /></Grid>
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Cpu, Mode=OneWay}" Maximum="100" Unit=" %" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Gpu, Mode=OneWay}" Maximum="100" Unit=" %" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RAM" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Ram, Mode=OneWay}" Maximum="100" Unit=" %" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VRAM" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Vram, Mode=OneWay}" Maximum="100" Unit=" %" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FPS" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Fps, Mode=OneWay}" Unit=" fps" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FRAME TIME" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.FrameTime, Mode=OneWay}" Unit=" ms" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="NETWORK LATENCY" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Latency, Mode=OneWay}" Unit=" ms" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource StormPanelStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="NETWORK DOWNLOAD" Style="{StaticResource StormSectionTitleStyle}" />
                        <c:LineChart Height="150" Values="{x:Bind ViewModel.Download, Mode=OneWay}" Unit=" Mbit/s" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

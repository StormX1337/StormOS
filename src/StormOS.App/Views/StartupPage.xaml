<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    xmlns:vm="using:StormOS.App.ViewModels">

    <Grid Padding="28,16,28,28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Startup" Style="{StaticResource StormPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource StormPageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupRow">
                    <Border Style="{StaticResource StormPanelStyle}" Padding="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource StormCaptionStyle}"><Run Text="{x:Bind Publisher}" /><Run Text=" · " /><Run Text="{x:Bind Source}" /></TextBlock>
                                <TextBlock Text="{x:Bind Command}" Style="{StaticResource StormCaptionStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="STARTUP IMPACT" Style="{StaticResource StormLabelStyle}" />
                                <TextBlock Text="{x:Bind Impact}" Style="{StaticResource StormValueStyle}" />
                                <TextBlock Text="{x:Bind Access}" Style="{StaticResource StormCaptionStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind h:Format.PassBrush(IsEnabled)}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="{x:Bind ToggleLabel}" Click="OnToggle" IsEnabled="{x:Bind CanToggle}" />
                                <Button Content="Open location" Click="OnOpenLocation" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    xmlns:vm="using:StormOS.App.ViewModels">

    <Grid Padding="28,16,28,28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Games" Style="{StaticResource StormPageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource StormPageSubtitleStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Rescan launchers" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Games}" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:GameItem">
                    <Border Style="{StaticResource StormPanelStyle}" Padding="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource StormBadgeStyle}" Visibility="{x:Bind h:Format.Show(IsRunning)}"><TextBlock Text="{x:Bind RunningText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource StormAccentBrush}" /></Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource StormLabelStyle}"><Run Text="{x:Bind Launcher}" /><Run Text=" · " /><Run Text="{x:Bind Installed}" /><Run Text=" · v" /><Run Text="{x:Bind Version}" /></TextBlock>
                                <TextBlock Text="{x:Bind ProfileStatus}" Style="{StaticResource StormCaptionStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" ColumnSpacing="16" RowSpacing="4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="Executable" Style="{StaticResource StormLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Executable}" Style="{StaticResource StormValueStyle}" />
                                <TextBlock Grid.Row="1" Text="Last played" Style="{StaticResource StormLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind LastPlayed}" Style="{StaticResource StormValueStyle}" />
                                <TextBlock Grid.Row="2" Text="Last benchmark" Style="{StaticResource StormLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind LastBenchmark}" Style="{StaticResource StormValueStyle}" />
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="LAUNCH" Click="OnLaunch" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="OPTIMIZE" Click="OnOptimize" IsEnabled="{x:Bind HasProfile}" />
                                <Button Content="BENCHMARK" Click="OnBenchmark" />
                                <Button Content="OPEN PROFILE" Click="OnOpenProfile" />
                                <Button Content="RESTORE" Click="OnRestore" IsEnabled="{x:Bind HasProfile}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StormOS.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:StormOS.App.Helpers"
    xmlns:vm="using:StormOS.App.ViewModels">

    <Page.Resources>
        <Style x:Key="HistoryItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,16,28,28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource StormPageTitleStyle}" />
                <TextBlock Text="Everything STORM OS measured or changed, stored locally on this PC." Style="{StaticResource StormPageSubtitleStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="RESTORE ALL" Command="{x:Bind ViewModel.RestoreAllCommand}" />
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="1">
            <PivotItem Header="Sessions">
                <ListView ItemsSource="{x:Bind ViewModel.Sessions}" SelectionMode="None" ItemContainerStyle="{StaticResource HistoryItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="90" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Started}" Style="{StaticResource StormCaptionStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Duration}" Style="{StaticResource StormValueStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Fps}" Style="{StaticResource StormValueStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Source}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Load}" Style="{StaticResource StormCaptionStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Temps}" Style="{StaticResource StormCaptionStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="Optimizations">
                <ListView ItemsSource="{x:Bind ViewModel.Changes}" SelectionMode="None" ItemContainerStyle="{StaticResource HistoryItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Who}" Style="{StaticResource StormCaptionStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Change}" Style="{StaticResource StormBodyStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Outcome}" Foreground="{x:Bind h:Format.PassBrush(Succeeded)}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Rollback}" Style="{StaticResource StormCaptionStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="5" Content="Restore" Click="OnRestore" Visibility="{x:Bind h:Format.Show(CanRestore)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="Benchmarks">
                <ListView ItemsSource="{x:Bind ViewModel.Benchmarks}" SelectionMode="None" ItemContainerStyle="{StaticResource HistoryItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BenchmarkRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource StormCaptionStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Summary}" Style="{StaticResource StormValueStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ScoreText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="Network tests">
                <ListView ItemsSource="{x:Bind ViewModel.NetworkTests}" SelectionMode="None" ItemContainerStyle="{StaticResource HistoryItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkReportRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="60" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource StormCaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Score}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Summary}" Style="{StaticResource StormValueStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Adapter}" Style="{StaticResource StormCaptionStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="System changes">
                <ListView ItemsSource="{x:Bind ViewModel.Events}" SelectionMode="None" ItemContainerStyle="{StaticResource HistoryItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource StormCaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Category}" Style="{StaticResource StormLabelStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Result}" Foreground="{x:Bind h:Format.PassBrush(Succeeded)}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Details}" Style="{StaticResource StormCaptionStyle}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>

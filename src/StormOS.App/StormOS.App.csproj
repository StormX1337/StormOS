<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(StormAppTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>StormOS.App</RootNamespace>
    <AssemblyName>StormOS</AssemblyName>
    <Description>STORM OS desktop application.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StormOS.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- CA1822: x:Bind binds through the view model instance. CA1001: page view models own short-lived
         CancellationTokenSources that are disposed when the operation or page ends. -->
    <NoWarn>$(NoWarn);CS1591;CA1822;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StormOS.Core\StormOS.Core.csproj" />
    <ProjectReference Include="..\StormOS.Security\StormOS.Security.csproj" />
    <ProjectReference Include="..\StormOS.Infrastructure\StormOS.Infrastructure.csproj" />
    <ProjectReference Include="..\StormOS.Services\StormOS.Services.csproj" />
    <ProjectReference Include="..\StormOS.Windows\StormOS.Windows.csproj" />
    <ProjectReference Include="..\StormOS.Hardware\StormOS.Hardware.csproj" />
    <ProjectReference Include="..\StormOS.Performance\StormOS.Performance.csproj" />
    <ProjectReference Include="..\StormOS.Network\StormOS.Network.csproj" />
    <ProjectReference Include="..\StormOS.Games\StormOS.Games.csproj" />
    <ProjectReference Include="..\StormOS.Optimization\StormOS.Optimization.csproj" />
    <ProjectReference Include="..\StormOS.Benchmark\StormOS.Benchmark.csproj" />
    <ProjectReference Include="..\StormOS.Overlay\StormOS.Overlay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\profiles\*.json" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

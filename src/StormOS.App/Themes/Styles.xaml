<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="StormDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="StormTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="StormMonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="StormPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StormPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StormPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="StormSubtlePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StormSubtleFillBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="StormPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StormDisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextPrimaryBrush}" />
    </Style>

    <Style x:Key="StormPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StormSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextSecondaryBrush}" />
    </Style>

    <Style x:Key="StormMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StormDisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextPrimaryBrush}" />
    </Style>

    <Style x:Key="StormLargeValueStyle" TargetType="TextBlock" BasedOn="{StaticResource StormMetricValueStyle}">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Foreground" Value="{ThemeResource StormAccentBrush}" />
    </Style>

    <Style x:Key="StormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StormValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StormBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StormCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StormTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StormBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StormAccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StormQuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="170" />
    </Style>
</ResourceDictionary>

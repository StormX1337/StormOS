  <ItemGroup>
    <ProjectReference Include="..\StormOS.Core\StormOS.Core.csproj" />
    <ProjectReference Include="..\StormOS.Performance\StormOS.Performance.csproj" />
    <ProjectReference Include="..\StormOS.Network\StormOS.Network.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
</Project>

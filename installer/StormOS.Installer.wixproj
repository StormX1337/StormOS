<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Builds the STORM OS MSI from a publish folder that contains the app, the service and the CLI.
    Use scripts/publish.ps1, which publishes the binaries and then builds this project.
    Required properties: PublishDir (with trailing backslash), ProductVersion (major.minor.patch).
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <OutputName>StormOS-$(ProductVersion)-$(Platform)</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>

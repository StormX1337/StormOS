# STORM Cloud configuration. Copy to .env and fill in. Never commit real values.
# The API validates this file at startup and refuses to run with missing or unsafe settings.

NODE_ENV=production
PORT=4000

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_DB=storm
POSTGRES_USER=storm
POSTGRES_PASSWORD=
# For running the API outside docker compose:
DATABASE_URL=postgresql://storm:CHANGE_ME@localhost:5432/storm

# Optional: Redis for distributed rate limits and caching (the API works without it)
REDIS_URL=

# Set to true when the API runs behind a reverse proxy (nginx) so client IPs are correct
TRUST_PROXY=false

# Browser origins allowed to call the API / realtime channel (comma separated)
CORS_ORIGINS=https://stormos.app,https://admin.stormos.app
WEB_ORIGIN=https://stormos.app

# Access tokens (HS256). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Entitlement (license) signing key: a P-256 private key. Generate:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# The matching public key is served at /api/v1/system/entitlement-key and configured in the
# desktop app as Licensing:PublicKeyPem.
ENTITLEMENT_PRIVATE_KEY=
ENTITLEMENT_TOKEN_TTL_HOURS=72
MAX_DEVICES_PER_USER=10

# Stripe (optional; billing endpoints return 503 when unset). Use live keys in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_ULTIMATE_MONTH=
STRIPE_PRICE_ULTIMATE_YEAR=

# AI analysis: "rules" (deterministic, no external calls) or "anthropic" (adds Claude, requires a key)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_DAILY_LIMIT=50

# Web portal / admin panel (server-side only)
STORM_API_URL=http://localhost:4000

# Seeding (packages/database: pnpm db:seed). Creates an administrator only when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# TLS certificates for the nginx container (fullchain.pem, privkey.pem)
TLS_CERT_DIR=../nginx/certs
